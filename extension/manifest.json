{
  "manifest_version": 2,
  "name": "Passkey Vault + Phone QR",
  "version": "0.3.0",
  "description": "Stores passkeys in an encrypted local vault and can use your phone via the FIDO hybrid QR flow.",
  "browser_specific_settings": {
    "gecko": {
      "id": "passkey-qr@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "scripts": [
      "authenticator.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Passkeys"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}